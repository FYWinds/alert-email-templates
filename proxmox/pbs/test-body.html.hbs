{{!--
  Copyright (c) 2026 FYWinds
  Generated by preview/build.py from proxmox/src/test.html.hbs and proxmox/src/layout.html.hbs; edit those, not this file.

  Setting: "web-url" is the base of the button links. Point it at the URL you
  open the web UI with, e.g. https://pve.example.com behind a reverse proxy.
--}}
{{#*inline "web-url"}}{{base-url}}{{/inline}}
{{!-- The test notification carries only "target": no hostname, no fqdn. --}}
{{#*inline "accent"}}#2563eb{{/inline}}
{{#*inline "tint"}}#eff6ff{{/inline}}
{{#*inline "status"}}● Test{{/inline}}
{{#*inline "headline"}}Test notification{{/inline}}
{{#*inline "subline"}}Target {{target}}{{/inline}}
{{#*inline "preheader"}}Notification target {{target}} delivers email.{{/inline}}
{{#*inline "content"}}
{{#> card}}{{> message v="If you can read this, the notification target works. Failure emails look like this one, with a red bar."}}{{/card}}
{{/inline}}
{{#*inline "actions"}}{{/inline}}
{{!-- Building blocks. A card with an optional title. --}}
{{#*inline "card"}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="card" style="background:#ffffff;border:1px solid #e6e8ec;border-radius:14px;margin:0 0 12px 0;border-collapse:separate;">
<tr><td style="padding:16px 18px 18px 18px;">
  {{#if title}}<div class="t-muted" style="margin:0 0 8px 0;font-size:12px;line-height:16px;letter-spacing:0.06em;text-transform:uppercase;color:#94a3b8;font-weight:600;">{{title}}</div>{{/if}}
  {{> @partial-block}}
</td></tr>
</table>{{/inline}}
{{!-- Key/value rows: wrap "row" partials in "facts". mono=true for ids and paths. --}}
{{#*inline "facts"}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{{> @partial-block}}</table>{{/inline}}
{{#*inline "row"}}<tr>
  <td class="t-muted" style="width:104px;padding:3px 0;font-size:13px;line-height:20px;color:#94a3b8;vertical-align:top;">{{k}}</td>
  <td class="t-strong" style="padding:3px 0;font-size:{{#if mono}}13px{{else}}14px{{/if}};line-height:20px;color:#0f172a;{{#if mono}}font-family:ui-monospace,SFMono-Regular,Menlo,monospace;{{/if}}word-break:break-all;">{{v}}</td>
</tr>{{/inline}}
{{#*inline "message"}}<div class="t-strong" style="font-size:15px;line-height:22px;color:#0f172a;white-space:pre-wrap;word-break:break-word;">{{v}}</div>{{/inline}}
{{#*inline "pre"}}<pre class="code" style="margin:0;padding:12px;border:1px solid #eef0f3;border-radius:10px;background:#f8fafc;color:#334155;font-size:12px;line-height:18px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap;word-break:break-all;">{{v}}</pre>{{/inline}}
{{#*inline "dot"}}<div style="width:8px;height:8px;border-radius:4px;background:{{#if ok}}#16a34a{{else}}#dc2626{{/if}};font-size:0;line-height:0;">&nbsp;</div>{{/inline}}
{{#*inline "pill"}}<span class="pill" style="display:inline-block;padding:0 8px;border-radius:999px;background:{{#if ok}}#f0fdf4{{else}}#fef2f2{{/if}};color:{{#if ok}}#16a34a{{else}}#dc2626{{/if}};font-size:12px;line-height:20px;font-weight:600;">{{v}}</span>{{/inline}}
{{#*inline "button"}}<a class="btn-primary" href="{{> web-url}}{{path}}" style="display:inline-block;padding:9px 14px;border-radius:10px;background:#0f172a;color:#ffffff;font-size:14px;line-height:18px;font-weight:600;text-decoration:none;">{{label}}</a>{{/inline}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{> headline}}</title>
<style>
  body { margin:0; padding:0; -webkit-text-size-adjust:100%; }
  a { text-decoration:none; }
  @media (prefers-color-scheme: dark) {
    .bg { background:#0b0d12 !important; }
    .card, .hero { background:#151922 !important; }
    .card { border-color:#242a35 !important; }
    .hero { border-left-color:#242a35 !important; border-right-color:#242a35 !important; border-bottom-color:#242a35 !important; }
    .t-strong { color:#e7eaf0 !important; }
    .t-body { color:#a7b0bf !important; }
    .t-muted { color:#6b7585 !important; }
    .code { background:#0f1218 !important; color:#c9d1dc !important; border-color:#242a35 !important; }
    .btn-primary { background:#e7eaf0 !important; color:#0b0d12 !important; }
    .divider { border-color:#242a35 !important; }
    .pill { background:transparent !important; box-shadow:inset 0 0 0 1px currentColor; }
  }
</style>
</head>
<body class="bg" style="margin:0;padding:0;background:#f2f4f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">{{> preheader}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg" style="background:#f2f4f7;">
<tr><td align="center" style="padding:20px 12px 28px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">

  <tr><td class="t-muted" style="padding:0 4px 10px 4px;font-size:12px;line-height:16px;letter-spacing:0.06em;text-transform:uppercase;color:#94a3b8;font-weight:600;">Proxmox Backup Server</td></tr>

  <tr><td>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="hero" style="background:#ffffff;border:1px solid #e6e8ec;border-top:5px solid {{> accent}};border-radius:16px;border-collapse:separate;margin:0 0 12px 0;">
      <tr><td style="padding:18px 18px 20px 18px;">
        <span class="pill" style="display:inline-block;padding:3px 10px;border-radius:999px;background:{{> tint}};color:{{> accent}};font-size:12px;line-height:18px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;">{{> status}}</span>
        <div class="t-strong" style="margin:12px 0 0 0;font-size:24px;line-height:30px;font-weight:700;color:#0f172a;word-break:break-word;">{{> headline}}</div>
        <div class="t-body" style="margin:6px 0 0 0;font-size:14px;line-height:20px;color:#64748b;word-break:break-word;">{{> subline}}</div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td>
{{> content}}
  </td></tr>

  <tr><td style="padding:4px 0 0 0;">{{> actions}}</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
